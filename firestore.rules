rules_version = '2';

// WeTravel Firestore 安全規則
// 部署方式：Firebase Console → Firestore Database → 規則 → 貼上本檔內容 → 發布
//
// 協作模型：行程以「知道連結（tripId）即可協作」的方式共享，
// 因此已登入（含匿名登入）者可讀寫 trips；其餘路徑一律拒絕。
service cloud.firestore {
  match /databases/{database}/documents {

    // 行程文件：需登入（App 使用匿名登入）
    // 刪除一律拒絕：App 採封存制（archived 旗標），不存在正當的刪除路徑；
    // 這條規則防止有人繞過 App 直接呼叫 deleteDoc 毀損資料。
    match /trips/{tripId} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;

      // 支出改存成獨立子集合文件（每筆支出各自一份 doc），避免多人同時新增/修改支出時
      // 整份 expenses 陣列互相覆蓋。子集合路徑不會自動繼承上層 /trips/{tripId} 的規則，
      // 必須另外宣告，否則會被下面的 catch-all 擋掉——套用跟父層完全相同的政策（需登入、只能軟刪除）。
      match /expenses/{expenseId} {
        allow read, create, update: if request.auth != null;
        allow delete: if false;
      }
    }

    // 其他所有路徑：一律拒絕
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
